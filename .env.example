# InfoStitch - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_ENV=development          # development, staging, production
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json              # json, console

# ============================================
# Database
# ============================================
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./infostitch.db

# PostgreSQL (production) - uncomment and configure
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/infostitch

# ============================================
# External API Keys (store secrets in .env, not in DB)
# ============================================
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=            # Optional: second key for rotation

# Jina AI Reader
JINA_API_KEY=your_jina_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_channel_chat_id_here  # e.g., -1001234567890
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here  # For error notifications

# VK API
VK_ACCESS_TOKEN=your_vk_access_token_here
VK_GROUP_ID=your_vk_group_id_here
VK_ALBUM_ID=                 # Optional: for photo uploads

# Max (Odnoklassniki) API
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_CHAT_ID=your_max_chat_id_here

# ============================================
# Pipeline Settings (can be overridden in DB settings table)
# ============================================
PIPELINE_INTERVAL_HOURS=3
MAX_ARTICLES_PER_RUN=20
JACCARD_THRESHOLD=0.55
EMBEDDING_SIMILARITY_THRESHOLD=0.75
EMBEDDING_MODEL=text-embedding-004
POST_LENGTH_MIN=700
POST_LENGTH_MAX=730
POST_TOTAL_MAX_LENGTH=1000
DEDUP_WINDOW_DAYS_STAGE1=7
DEDUP_WINDOW_DAYS_STAGE2=5
CLEANUP_RETENTION_DAYS=90

# ============================================
# Dashboard
# ============================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
# Default admin user (change password on first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123